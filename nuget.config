<?xml version="1.0" encoding="utf-8"?>
<!-- Makes this project download NuGet packages only from nuget.org,
     ignoring any other (private) package sources configured on this machine. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
