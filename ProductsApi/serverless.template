{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Transform": "AWS::Serverless-2016-10-31",
  "Description": "Products CRUD API: 5 Lambda functions behind an API Gateway HTTP API, storing data in SQL Server. This template is partially managed by Amazon.Lambda.Annotations (v1.5.0.0).",
  "Parameters": {
    "SqlServer": {
      "Type": "String",
      "Description": "SQL Server address and port, e.g. mydb.abc123.us-east-1.rds.amazonaws.com,1433",
      "Default": "P1225LP166,1433"
    },
    "SqlDatabase": {
      "Type": "String",
      "Default": "ProductsDb",
      "Description": "Database name that contains the Products table"
    },
    "SqlUser": {
      "Type": "String",
      "Description": "SQL Server login name (SQL authentication)",
      "Default": "sa"
    },
    "SqlPassword": {
      "Type": "String",
      "NoEcho": true,
      "Description": "Password for the SQL Server login (hidden in the AWS console)"
    }
  },
  "Globals": {
    "Function": {
      "Environment": {
        "Variables": {
          "SQL_CONNECTION_STRING": {
            "Fn::Sub": "Server=${SqlServer};Database=${SqlDatabase};User Id=${SqlUser};Password=${SqlPassword};Encrypt=True;TrustServerCertificate=True;"
          }
        }
      }
    }
  },
  "Resources": {
    "CreateProductFunction": {
      "Type": "AWS::Serverless::Function",
      "Metadata": {
        "Tool": "Amazon.Lambda.Annotations",
        "SyncedEvents": [
          "RootPost"
        ],
        "SyncedEventProperties": {
          "RootPost": [
            "Path",
            "Method"
          ]
        }
      },
      "Properties": {
        "Runtime": "dotnet8",
        "CodeUri": ".",
        "MemorySize": 512,
        "Timeout": 30,
        "Policies": [
          "AWSLambdaBasicExecutionRole",
          "AWSLambdaVPCAccessExecutionRole"
        ],
        "PackageType": "Zip",
        "Handler": "ProductsApi::ProductsApi.Functions_CreateProduct_Generated::CreateProduct",
        "Events": {
          "RootPost": {
            "Type": "HttpApi",
            "Properties": {
              "Path": "/products",
              "Method": "POST"
            }
          }
        }
      }
    },
    "GetProductsFunction": {
      "Type": "AWS::Serverless::Function",
      "Metadata": {
        "Tool": "Amazon.Lambda.Annotations",
        "SyncedEvents": [
          "RootGet"
        ],
        "SyncedEventProperties": {
          "RootGet": [
            "Path",
            "Method"
          ]
        }
      },
      "Properties": {
        "Runtime": "dotnet8",
        "CodeUri": ".",
        "MemorySize": 512,
        "Timeout": 30,
        "Policies": [
          "AWSLambdaBasicExecutionRole",
          "AWSLambdaVPCAccessExecutionRole"
        ],
        "PackageType": "Zip",
        "Handler": "ProductsApi::ProductsApi.Functions_GetProducts_Generated::GetProducts",
        "Events": {
          "RootGet": {
            "Type": "HttpApi",
            "Properties": {
              "Path": "/products",
              "Method": "GET"
            }
          }
        }
      }
    },
    "GetProductFunction": {
      "Type": "AWS::Serverless::Function",
      "Metadata": {
        "Tool": "Amazon.Lambda.Annotations",
        "SyncedEvents": [
          "RootGet"
        ],
        "SyncedEventProperties": {
          "RootGet": [
            "Path",
            "Method"
          ]
        }
      },
      "Properties": {
        "Runtime": "dotnet8",
        "CodeUri": ".",
        "MemorySize": 512,
        "Timeout": 30,
        "Policies": [
          "AWSLambdaBasicExecutionRole",
          "AWSLambdaVPCAccessExecutionRole"
        ],
        "PackageType": "Zip",
        "Handler": "ProductsApi::ProductsApi.Functions_GetProduct_Generated::GetProduct",
        "Events": {
          "RootGet": {
            "Type": "HttpApi",
            "Properties": {
              "Path": "/products/{id}",
              "Method": "GET"
            }
          }
        }
      }
    },
    "UpdateProductFunction": {
      "Type": "AWS::Serverless::Function",
      "Metadata": {
        "Tool": "Amazon.Lambda.Annotations",
        "SyncedEvents": [
          "RootPut"
        ],
        "SyncedEventProperties": {
          "RootPut": [
            "Path",
            "Method"
          ]
        }
      },
      "Properties": {
        "Runtime": "dotnet8",
        "CodeUri": ".",
        "MemorySize": 512,
        "Timeout": 30,
        "Policies": [
          "AWSLambdaBasicExecutionRole",
          "AWSLambdaVPCAccessExecutionRole"
        ],
        "PackageType": "Zip",
        "Handler": "ProductsApi::ProductsApi.Functions_UpdateProduct_Generated::UpdateProduct",
        "Events": {
          "RootPut": {
            "Type": "HttpApi",
            "Properties": {
              "Path": "/products/{id}",
              "Method": "PUT"
            }
          }
        }
      }
    },
    "DeleteProductFunction": {
      "Type": "AWS::Serverless::Function",
      "Metadata": {
        "Tool": "Amazon.Lambda.Annotations",
        "SyncedEvents": [
          "RootDelete"
        ],
        "SyncedEventProperties": {
          "RootDelete": [
            "Path",
            "Method"
          ]
        }
      },
      "Properties": {
        "Runtime": "dotnet8",
        "CodeUri": ".",
        "MemorySize": 512,
        "Timeout": 30,
        "Policies": [
          "AWSLambdaBasicExecutionRole",
          "AWSLambdaVPCAccessExecutionRole"
        ],
        "PackageType": "Zip",
        "Handler": "ProductsApi::ProductsApi.Functions_DeleteProduct_Generated::DeleteProduct",
        "Events": {
          "RootDelete": {
            "Type": "HttpApi",
            "Properties": {
              "Path": "/products/{id}",
              "Method": "DELETE"
            }
          }
        }
      }
    }
  },
  "Outputs": {
    "ApiUrl": {
      "Description": "Base URL of the Products API",
      "Value": {
        "Fn::Sub": "https://${ServerlessHttpApi}.execute-api.${AWS::Region}.amazonaws.com"
      }
    }
  }
}